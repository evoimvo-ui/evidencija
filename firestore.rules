rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- POMOĆNE FUNKCIJE ---
    
    // Provjerava je li korisnik prijavljen
    function isSignedIn() {
      return request.auth != null;
    }

    // Dohvaća podatke trenutnog korisnika iz 'users' kolekcije
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Provjerava je li korisnik vlasnik (owner) radnje kojoj dokument pripada
    function isOwnerOf(shopId) {
      return isSignedIn() && getUserData().role == 'owner' && getUserData().shopId == shopId;
    }

    // Provjerava opći pristup podacima (vlasnik dokumenta ili vlasnik radnje)
    function canAccessData(data) {
      return isSignedIn() && (
        request.auth.uid == data.userId || 
        isOwnerOf(data.shopId)
      );
    }

    // --- PRAVILA ZA KOLEKCIJE ---

    // 1. Korisnički profili
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      // Vlasnik može vidjeti profile svojih radnika unutar iste radnje
      allow read: if isSignedIn() && getUserData().shopId == resource.data.shopId;
    }

    // 2. Radnje (Shops)
    match /shops/{shopId} {
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid || 
        getUserData().shopId == shopId
      );
      // POPRAVAK: Korisnik može kreirati radnju samo ako sebe postavi kao vlasnika
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // 3. Pozivnice (Invites)
    match /invites/{inviteId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && getUserData().role == 'owner';
    }
    
    // 4. Logovi (Logs) - samo slanje logova s klijenta, bez čitanja
    match /logs/{logId} {
      allow create: if isSignedIn(); 
      allow read, update, delete: if false;
    }

    // 5. Konfiguracija (Config) - npr. whitelist
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false; // Pisanje dozvoljeno samo kroz Firebase konzolu (Admin)
    }

    // 6. Unosi (Entries)
    match /entries/{docId} {
      allow read, update, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data) && request.resource.data.userId == request.auth.uid;
    }

    // 7. Termini (Appointments)
    match /appointments/{docId} {
      allow read, update, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data) && request.resource.data.userId == request.auth.uid;
    }

    // 8. Usluge (Services)
    match /services/{docId} {
      allow read, update, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data) && request.resource.data.userId == request.auth.uid;
    }

    // 9. Klijenti (Clients)
    match /clients/{docId} {
      allow read, update, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data) && request.resource.data.userId == request.auth.uid;
    }
  }
}
