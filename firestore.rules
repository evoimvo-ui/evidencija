rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- POMOĆNE FUNKCIJE ---
    
    // Provjerava je li korisnik prijavljen
    function isSignedIn() {
      return request.auth != null;
    }

    // Dohvaća podatke trenutnog korisnika iz 'users' kolekcije
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Provjerava je li korisnik vlasnik (owner) radnje kojoj dokument pripada
    function isOwnerOf(shopId) {
      return isSignedIn() && getUserData().role == 'owner' && getUserData().shopId == shopId;
    }

    // Provjerava opći pristup podacima (vlasnik dokumenta ili vlasnik radnje)
    function canAccessData(data) {
      return isSignedIn() && (
        request.auth.uid == data.userId || 
        isOwnerOf(data.shopId)
      );
    }

    // Provjerava je li korisnik imao pravo na pisanje podataka (aktivni trial ili pretplata)
    function hasWriteAccess() {
      let userData = getUserData();
      
      // Lifetime access
      if (userData.subscriptionStatus == 'lifetime') {
        return true;
      }
      
      // Aktivna pretplata
      if (userData.subscriptionStatus == 'active') {
        return true;
      }
      
      // Otkazana pretplata, ali još uvijek u plaćenom periodu
      if (userData.subscriptionStatus == 'cancelled' && userData.nextBillingDate != null) {
        return timestamp.value(request.time) < timestamp.value(userData.nextBillingDate);
      }
      
      // Aktivni trial
      if (userData.subscriptionStatus == 'trial' && userData.trialStartedAt != null) {
        let trialEnd = userData.trialStartedAt + duration.value(30, 'd');
        return request.time < trialEnd;
      }
      
      // U suprotnom, nema pristupa pisanju
      return false;
    }

    // --- PRAVILA ZA KOLEKCIJE ---

    // 1. Korisnički profili
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      // Vlasnik može vidjeti profile svojih radnika unutar iste radnje
      allow read: if isSignedIn() && getUserData().shopId == resource.data.shopId;
    }

    // 2. Radnje (Shops)
    match /shops/{shopId} {
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid || 
        getUserData().shopId == shopId
      );
      // POPRAVAK: Korisnik može kreirati radnju samo ako sebe postavi kao vlasnika
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // 3. Pozivnice (Invites)
    match /invites/{inviteId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && getUserData().role == 'owner';
    }
    
    // 4. Logovi (Logs) - samo slanje logova s klijenta, bez čitanja
    match /logs/{logId} {
      allow create: if isSignedIn(); 
      allow read, update, delete: if false;
    }

    // 5. Konfiguracija (Config) - npr. whitelist
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false; // Pisanje dozvoljeno samo kroz Firebase konzolu (Admin)
    }

    // 6. Unosi (Entries)
    match /entries/{docId} {
      allow read: if canAccessData(resource.data);
      allow create, update, delete: if canAccessData(request.resource.data) && request.resource.data.userId == request.auth.uid && hasWriteAccess();
    }

    // 7. Termini (Appointments)
    match /appointments/{docId} {
      allow read: if canAccessData(resource.data);
      allow create, update, delete: if canAccessData(request.resource.data) && request.resource.data.userId == request.auth.uid && hasWriteAccess();
    }

    // 8. Usluge (Services)
    match /services/{docId} {
      allow read: if canAccessData(resource.data);
      allow create, update, delete: if canAccessData(request.resource.data) && request.resource.data.userId == request.auth.uid && hasWriteAccess();
    }

    // 9. Klijenti (Clients)
    match /clients/{docId} {
      allow read: if canAccessData(resource.data);
      allow create, update, delete: if canAccessData(request.resource.data) && request.resource.data.userId == request.auth.uid && hasWriteAccess();
    }
    
    // 10. Ne radni dani (TimeOff)
    match /timeOff/{docId} {
      allow read: if canAccessData(resource.data);
      allow create, update, delete: if canAccessData(request.resource.data) && request.resource.data.userId == request.auth.uid && hasWriteAccess();
    }
  }
}
